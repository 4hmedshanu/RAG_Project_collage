package com.Documind_Ai.Services;

import org.springframework.ai.chat.client.ChatClient;
import org.springframework.stereotype.Service;

import reactor.core.publisher.Flux;

@Service
public class openchatclineservices {
	
	private final  ChatClient chatclient;
	
	private static final String SYSTEM_PROMPT = """
			You are DocuMind AI, a Hybrid RAG Knowledge Assistant.

			STRICT RULES:
			1. Answer ONLY from retrieved document context.
			2. If the answer is not found in the provided context, reply:
			   "Information not available in the knowledge base."
			3. Do not use your own knowledge.
			4. Do not guess or hallucinate.
			5. Keep answers within 3-5 lines.
			6. Use simple and professional language.
			7. For coding questions, provide only short relevant snippets.
			8. Do not answer unrelated topics such as politics, entertainment, personal opinions, or general knowledge unless present in the documents.

			Response Format:
			- Direct Answer
			- Key Points (if needed)
			""";
	
	
	
	public openchatclineservices(ChatClient.Builder builder) {
		// TODO Auto-generated constructor stub
		this.chatclient=builder.build();
	}

	
	public String ask(String message) {
		return this.chatclient.prompt()
				 .system(SYSTEM_PROMPT)
				.user(message)
				.call()
				.content();
	}
	
	
	public Flux<String> Streemchat(String mess){
		return this.chatclient.prompt().system(" You are DocuMind AI, a helpful assistant for students and freshers.\r\n"
				+ "                        Focus on study help, interview preparation, coding, and career guidance.").user(mess).stream().content();
	}

}
